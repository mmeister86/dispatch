[llm]
provider = "anthropic" # anthropic | openai | gemini | openrouter | xai
model = "claude-sonnet-4-6"
api_key = "" # or env: LLM_API_KEY

[postiz]
api_key = "" # or env: POSTIZ_API_KEY
base_url = "https://api.postiz.com" # or direct MCP/self-hosted URL via POSTIZ_BASE_URL

[github]
token = "" # or env: GITHUB_TOKEN; read access is enough for current tools

[search]
provider = "perplexity" # currently Perplexity/Sonar-oriented
api_key = "" # optional; or env: SEARCH_API_KEY
model = "sonar-pro"
recency = "week" # hour | day | week | month
